#!/bin/bash
# Wird vom fm-update.timer (systemd --user) täglich aufgerufen: holt
# Updates aus dem fm-Git-Repo per 'git pull'. Lokale, noch nicht
# committete Änderungen werden NICHT gestasht oder überschrieben —
# --ff-only bricht in dem Fall sauber ab, es geht nichts verloren.
set -u
cd "$(dirname "$0")" || exit 1

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "fm-update: $(pwd) ist kein Git-Repository, überspringe." >&2
    exit 1
fi

BEFORE=$(git rev-parse HEAD)
if ! git pull --ff-only --quiet; then
    echo "fm-update: git pull fehlgeschlagen (lokale Änderungen oder abweichende Historie?) — übersprungen." >&2
    exit 1
fi
AFTER=$(git rev-parse HEAD)

if [ "$BEFORE" != "$AFTER" ]; then
    echo "fm-update: aktualisiert von ${BEFORE:0:8} auf ${AFTER:0:8}."
    if [ -f requirements.txt ] && [ -x venv/bin/pip ]; then
        venv/bin/pip install -q -r requirements.txt && echo "fm-update: Abhängigkeiten aktualisiert."
    fi
else
    echo "fm-update: bereits aktuell."
fi
